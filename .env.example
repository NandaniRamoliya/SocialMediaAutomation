# Copy to .env for local runs. In GitHub, add these as repository Secrets instead.
# Every value here is free to obtain: see docs/SETUP_FREE.md.

# Safety: nothing is really posted until this is false
SMM_DRY_RUN=true

# AI brain ($0): Google Gemini free tier (key from aistudio.google.com)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional, only with a Claude Pro/Max plan: LLM_PROVIDER=claude_code + token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
LLM_FALLBACK=

# Approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage. Empty = local SQLite file in data/. Production: Supabase free Postgres connection string
DATABASE_URL=

# Public image hosting for Instagram/Threads: supabase or imgbb
MEDIA_HOST=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
IMGBB_API_KEY=

# Facebook Page + Instagram (same Meta app)
META_PAGE_ID=
META_PAGE_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=

# Threads
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# LinkedIn (urn:li:person:XXXX or urn:li:organization:XXXX)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRES=

# X (Twitter) free tier, OAuth 1.0a user keys with Read+Write permission
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# YouTube (used once the video pipeline is on)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
